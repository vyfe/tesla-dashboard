# 复制成 .env 后填值：cp .env.example .env

# —— 必填：TeslaMate 的 PostgreSQL 只读连接串 ——
# 同 compose 项目里数据库服务名通常叫 database
DATABASE_URL=postgresql://tesla_readonly:换成你的密码@database:5432/teslamate

# 如果是跨主机访问，写服务器地址：
# DATABASE_URL=postgresql://tesla_readonly:换成你的密码@10.0.0.12:5432/teslamate

# —— 建议填：车辆标称容量（kWh），用于算「健康度 %」 ——
# Model 3 标续 60 / 长续航 75.6 / 高性能 78.4
# Model Y 标续 60 / 长续航 78.4
NOMINAL_KWH=75.6

# —— 强烈建议：看板登录（HTTP Basic）——
# 两个都填才生效；不填 = 没有任何鉴权，只能靠内网 / 反向代理兜底。
# 浏览器首次访问会弹原生登录框，前端无需改动。
DASHBOARD_USER=tesla
DASHBOARD_PASSWORD=换成你的看板密码

# —— 可选 ——
# 数据库时间戳是 UTC，按你的本地时区切分「天/月」，默认东八区
TZ_OFFSET_HOURS=8

# 多车时指定默认展示的车辆 id（库里 cars.id）
# DEFAULT_CAR_ID=1

# 单条 SQL 超时（毫秒），防止大表查询拖慢 TeslaMate
# STATEMENT_TIMEOUT_MS=20000

# 容器内监听端口
# PORT=8000

# 宿主只允许本机访问（默认，仅本仓库的 compose 生效）。
# 接进 TeslaMate 的 compose 时改端口映射那行；要局域网直连就写 0.0.0.0:4001:8000。
# DASHBOARD_BIND=127.0.0.1

# 置 1 才开放 /api/docs 与 /api/openapi.json，仅本地调试用
# ENABLE_DOCS=0
